# =============================================================================
# Next.js Frontend .dockerignore
# =============================================================================
# Optimizes Docker build context by excluding unnecessary files

# Dependencies (will be installed in container)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Build output (will be built in container)
.next/
out/
build/
dist/

# Git
.git/
.gitignore
.gitattributes

# Environment files (keep .env.local.example)
.env
.env.local
.env.*.local
.env.development
.env.production
.env.test
*.env
!.env.local.example

# Testing
coverage/
.nyc_output/
*.lcov
__tests__/
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx
vitest.config.ts
vitest.setup.ts

# IDEs and editors
.vscode/
.idea/
*.iml
*.iws
*.ipr
*.swp
*.swo
*~
*.code-workspace
*.sublime-project
*.sublime-workspace
\#*\#
.\#*

# OS files
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Vercel
.vercel/

# Documentation
README.md
*.md

# Logs
*.log
logs/

# Temporary files
tmp/
temp/
*.tmp
*.bak

# Auto Claude
.auto-claude/
