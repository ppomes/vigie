# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=statuspage

# JWT
JWT_SECRET_KEY=your-secret-key-change-in-production

# Email Provider (example: SendGrid)
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=your-sendgrid-api-key
EMAIL_FROM=noreply@yourdomain.com

# Server
PORT=8080
GIN_MODE=debug
