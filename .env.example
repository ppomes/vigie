# =============================================================================
# Status Page System - Environment Configuration
# =============================================================================
# Copy this file to .env and update with your actual values
# This file is used by Docker Compose to configure all services

# =============================================================================
# Database Configuration (MySQL)
# =============================================================================
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=statuspage

# For local development without Docker, use:
# DB_HOST=localhost

# =============================================================================
# API Service Configuration
# =============================================================================
API_PORT=8080
GIN_MODE=debug

# JWT Authentication
# CRITICAL: Change this to a secure random string in production
# Generate with: openssl rand -base64 32
JWT_SECRET_KEY=your-secret-key-change-in-production

# =============================================================================
# Email Provider Configuration
# =============================================================================
# Supported providers: sendgrid, mailgun, ses
EMAIL_PROVIDER=sendgrid

# SendGrid Configuration (if using sendgrid)
SENDGRID_API_KEY=your-sendgrid-api-key

# Mailgun Configuration (if using mailgun)
# MAILGUN_API_KEY=your-mailgun-api-key
# MAILGUN_DOMAIN=your-domain.com

# AWS SES Configuration (if using ses)
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key

# Email Sender
EMAIL_FROM=noreply@yourdomain.com

# =============================================================================
# Frontend Service Configuration
# =============================================================================
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# For Docker Compose, use:
# NEXT_PUBLIC_API_URL=http://api:8080/api/v1

# =============================================================================
# Admin Service Configuration
# =============================================================================
ADMIN_PORT=3001
# Admin uses the same API URL as frontend

# =============================================================================
# MySQL Service Configuration (for Docker Compose)
# =============================================================================
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=statuspage

# =============================================================================
# Development Settings
# =============================================================================
NODE_ENV=development

# =============================================================================
# Security Notes
# =============================================================================
# 1. Never commit the actual .env file to version control
# 2. Use strong, unique values for JWT_SECRET_KEY in production
# 3. Rotate JWT_SECRET_KEY periodically
# 4. Use environment-specific API keys (separate for dev/staging/prod)
# 5. Enable SSL/TLS in production (set GIN_MODE=release)
